# Origin of the FastAPI backend. Used server-side by the /api/* rewrite proxy
# in next.config.ts. Defaults to http://127.0.0.1:8000 when unset.
BACKEND_ORIGIN=http://127.0.0.1:8000

# Where the browser sends API calls. Leave as /api to use the same-origin
# proxy (recommended — the backend has no CORS middleware). Only override
# this if you have added CORS to the backend and want to call it directly.
NEXT_PUBLIC_API_BASE=/api
